load("@coralnpu_hw//rules:chisel.bzl", "chisel_library", "chisel_test", "chisel_binary", "chisel_cc_library")

package(default_visibility = ["//visibility:public"])

chisel_library(
    name = "peripheral",
    srcs = [
        "PeripheralInterface.scala",
    ],
    deps = [
        "//hdl/chisel/src/bus",
        "//hdl/chisel/src/common",
    ],
)

chisel_library(
    name = "vga",
    srcs = [
        "VGA.scala",
        "TrueDualPortRAM32.scala",
        "VgaStandaloneWrapper.scala",
    ],
    resources = [
        "//hdl/verilog:TrueDualPortRAM32.v",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//hdl/chisel/src/common",
    ],
)

# VGA Standalone Wrapper for testing - generates SystemVerilog
chisel_binary(
    name = "vga_standalone_wrapper",
    main_class = "peripheral.EmitVgaStandaloneWrapper",
    deps = [
        ":vga",
    ],
)

# VGA Verilator CC library for cocotb testing
chisel_cc_library(
    name = "vga_standalone_wrapper_cc_library",
    chisel_lib = ":vga",
    emit_class = "peripheral.EmitVgaStandaloneWrapper",
    module_name = "VgaStandaloneWrapper",
    verilog_file_path = "VgaStandaloneWrapper.sv",
    verilog_deps = [
        "//hdl/verilog:TrueDualPortRAM32",
    ],
    vopts = [
        "-Wno-UNOPTFLAT",
        "-Wno-WIDTHEXPAND",
        "-Wno-WIDTHTRUNC",
    ],
)

# Generate VGA.sv for cocotb tests
genrule(
    name = "VGA_sv_gen",
    srcs = [],
    outs = ["VGA.sv"],
    cmd = "CHISEL_FIRTOOL_PATH=$$(dirname $(execpath @coralnpu_hw//third_party/llvm-firtool:firtool)) ./$(location :vga_emit_binary) --target-dir=$(RULEDIR)",
    tools = [
        ":vga_emit_binary",
        "@coralnpu_hw//third_party/llvm-firtool:firtool",
    ],
)

# Alias for VgaStandaloneWrapper.sv (generated by cc_library above)
filegroup(
    name = "VgaStandaloneWrapper_sv",
    srcs = [":vga_standalone_wrapper_cc_library_emit_verilog"],
)

chisel_binary(
    name = "vga_emit_binary",
    main_class = "peripheral.EmitVGA",
    deps = [
        ":vga",
    ],
)

chisel_test(
    name = "peripheral_tests",
    srcs = [
        "PeripheralInterfaceTest.scala",
    ],
    deps = [
        ":peripheral",
        "//hdl/chisel/src/bus",
        "//hdl/chisel/src/common",
    ],
)

chisel_test(
    name = "vga_tests",
    srcs = [
        "VGATest.scala",
    ],
    deps = [
        ":vga",
    ],
)